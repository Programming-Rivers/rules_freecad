load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# This target must be built with the FreeCAD Python toolchain
py_binary(
    name = "hello_world",
    srcs = ["hello_world.py"],
    main = "hello_world.py",
    deps = [
        "//examples:package",
    ],
    target_compatible_with = [
        "//platforms:freecad_1.0.x",
    ],
)

py_binary(
    name = "dependency_demo",
    srcs = ["dependency_demo.py"],
    main = "dependency_demo.py",
    target_compatible_with = [
        "//platforms:freecad_1.0.x",
    ],
    deps = [
        "//examples/lib:dependency",
    ],
)
